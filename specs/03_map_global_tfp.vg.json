{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot density map of Australian agricultural production. Each dot = $200 million of annual gross output (2024-25), placed within its production region. Click the legend to isolate one farming sector.",
  "width": 650,
  "height": 380,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -133,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E0D0",
        "stroke": "#FBF8F3",
        "strokeWidth": 1.4
      }
    },
    {
      "data": {
        "url": "data/aus_ag_dot_density.csv"
      },
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "sector"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 18
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "sector",
          "type": "nominal",
          "scale": {
            "domain": [
              "Broadacre Cropping",
              "Beef & Sheep Livestock",
              "Horticulture & Cotton",
              "Dairy"
            ],
            "range": [
              "#1E4D3B",
              "#C85A32",
              "#D98A2B",
              "#3B6E8C"
            ]
          },
          "legend": {
            "title": "1 dot = $200 million",
            "orient": "top-left",
            "symbolSize": 110,
            "labelFontSize": 11.5
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 0.88
          },
          "value": 0.06
        },
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Production Region"
          },
          {
            "field": "sector",
            "type": "nominal",
            "title": "Farming Sector ($200M/dot)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 125.5,
            "lat": -24.2,
            "t": "Arid interior (<250mm rain) has no cropping,"
          },
          {
            "lon": 125.5,
            "lat": -25.8,
            "t": "supporting only low-density cattle stations"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "fill": "#5A635D"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, sans-serif",
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "legend": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "titleColor": "#1E4D3B"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
