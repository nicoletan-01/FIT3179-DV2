{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 440,
  "background": "transparent",
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "name": "world_graticule",
      "data": {
        "graticule": {
          "step": [30, 30]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#EAE3D2",
        "strokeWidth": 0.5,
        "fill": null
      }
    },
    {
      "name": "world_base_land",
      "data": {
        "url": "data/world_110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E5DFD0",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.5
      }
    },
    {
      "name": "tfp_choropleth",
      "data": {
        "url": "data/world_110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "id_num"
        },
        {
          "lookup": "id_num",
          "from": {
            "data": {
              "url": "data/usda_oecd_global_tfp.csv"
            },
            "key": "id",
            "fields": [
              "Country",
              "TFP_Index_2024",
              "Annual_TFP_Growth_Pct",
              "OECD_Producer_Support_Pct",
              "Highlight"
            ]
          }
        },
        {
          "filter": "datum.TFP_Index_2024 != null"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6,
        "cursor": "pointer"
      },
      "encoding": {
        "color": {
          "field": "TFP_Index_2024",
          "type": "quantitative",
          "scale": {
            "scheme": "ylgn",
            "domain": [115, 220]
          },
          "legend": {
            "title": "TFP Index (1990 = 100)",
            "orient": "bottom-left",
            "direction": "horizontal",
            "titleFontSize": 11.5,
            "labelFontSize": 11,
            "gradientLength": 220,
            "gradientThickness": 12
          }
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "TFP_Index_2024",
            "type": "quantitative",
            "title": "2024 TFP Index (1990=100)",
            "format": ".1f"
          },
          {
            "field": "Annual_TFP_Growth_Pct",
            "type": "quantitative",
            "title": "Annual TFP Growth (%)",
            "format": ".2f"
          },
          {
            "field": "OECD_Producer_Support_Pct",
            "type": "quantitative",
            "title": "OECD Producer Support PSE (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "name": "australia_outline",
      "data": {
        "url": "data/world_110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.id)",
          "as": "id_num"
        },
        {
          "filter": "datum.id_num == 36"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#1E4D3B",
        "strokeWidth": 1.8
      }
    },
    {
      "name": "australia_callout_halo",
      "data": {
        "values": [
          {
            "lon": 133.5,
            "lat": -25.5,
            "label": "Australia (TFP 164.2 | PSE 2.4%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 38,
        "fontSize": 11,
        "fontWeight": 700,
        "stroke": "#FFFFFF",
        "strokeWidth": 3.5,
        "strokeJoin": "round",
        "fill": "#FFFFFF"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "name": "australia_callout_text",
      "data": {
        "values": [
          {
            "lon": 133.5,
            "lat": -25.5,
            "label": "Australia (TFP 164.2 | PSE 2.4%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 38,
        "fontSize": 11,
        "fontWeight": 700,
        "fill": "#1E4D3B"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, sans-serif",
    "view": {
      "stroke": "transparent"
    }
  }
}
