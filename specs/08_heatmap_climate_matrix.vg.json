{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 270,
  "data": {
    "url": "data/state_climate_matrix.csv"
  },
  "mark": {
    "type": "rect",
    "stroke": "#FBF8F3",
    "strokeWidth": 1.5,
    "cornerRadius": 2
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Benchmark Climatic Year",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 11
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": "State"
    },
    "color": {
      "field": "TFP_Climate_Shock_Pct",
      "type": "quantitative",
      "scale": {
        "scheme": "redyellowgreen",
        "domain": [
          -25,
          25
        ]
      },
      "legend": {
        "title": "TFP Anomaly (%)",
        "orient": "bottom",
        "gradientLength": 220
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal"
      },
      {
        "field": "Year",
        "type": "ordinal"
      },
      {
        "field": "TFP_Climate_Shock_Pct",
        "type": "quantitative",
        "title": "Climate TFP Deviation (%)",
        "format": "+.1f"
      }
    ]
  },
  "config": {
    "background": "transparent",
    "font": "Source Sans 3, sans-serif",
    "autosize": {
      "type": "fit",
      "contains": "padding"
    },
    "axis": {
      "labelFontSize": 11.5,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#232725",
      "labelColor": "#454D48",
      "gridColor": "#EAE3D2",
      "domainColor": "#C7BFA8"
    },
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 11.5,
      "titleFontWeight": 600,
      "titleColor": "#1E4D3B"
    },
    "view": {
      "stroke": "transparent"
    }
  }
}
