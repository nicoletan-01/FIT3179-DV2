          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#1E4D3B",
        "stroke": "#D98A2B",
        "strokeWidth": 0.8,
        "interactive": false
