{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Pacific-Centred Global Agricultural Export Corridors (2024\u201325). Reduced to 8 major national destinations with zero label overlap and responsive interactive tooltips.",
  "title": {
    "text": "Pacific-Centred Global Agricultural Export Corridors (2024\u201325)",
    "subtitle": [
      "Connecting Australia to 8 primary international trading hubs (representing A$46.9B in farm export value).",
      "Line width denotes export value; line colour indicates region. Markers and labels are fully interactive with hover tooltips."
    ],
    "fontSize": 15,
    "subtitleFontSize": 11.5,
    "anchor": "start",
    "color": "#1E4D3B",
    "subtitleColor": "#5C6660",
    "offset": 14
  },
  "width": "container",
  "height": 520,
  "background": "transparent",
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "params": [
    {
      "name": "corridor_focus",
      "value": "All Trade Corridors",
      "bind": {
        "input": "select",
        "options": [
          "All Trade Corridors",
          "East Asia",
          "Southeast Asia",
          "North America",
          "Europe & Middle East",
          "South Asia & Oceania"
        ],
        "name": "Trade Corridor Filter: "
      }
    }
  ],
  "layer": [
    {
      "name": "ocean_graticule",
      "data": {
        "graticule": {
          "step": [
            30,
            30
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#EAE3D2",
        "strokeWidth": 0.5,
        "fill": null,
        "interactive": false
      }
    },
    {
      "name": "world_land",
      "data": {
        "url": "data/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME != 'Antarctica'"
