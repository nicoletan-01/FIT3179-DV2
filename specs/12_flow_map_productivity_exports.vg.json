      "mark": {
        "type": "line",
        "strokeCap": "round",
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "country",
          "type": "nominal"
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        },
        "strokeWidth": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              17000
            ],
            "range": [
              2.0,
              9.0
            ]
          },
          "legend": null
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale": {
            "domain": [
              "East Asia",
              "Southeast Asia",
              "North America",
              "Europe & Middle East",
              "South Asia & Oceania"
